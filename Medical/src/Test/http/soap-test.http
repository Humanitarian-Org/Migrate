### Test SOAP Message Processing via HTTP Function (Recommended Approach)
### This properly wraps the SOAP XML in an NServiceBus message

### Test 1: Send SOAP XML via HTTP Function (Local)
POST http://localhost:7076/api/soap
Content-Type: application/xml

<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope">
  <soap:Header>
    <wsa:MessageID xmlns:wsa="http://www.w3.org/2005/08/addressing">362291741250712573</wsa:MessageID>
  </soap:Header>
  <soap:Body>
    <ns3:RegisterHealthCaseRequest xmlns:ns3="http://www.immi.gov.au/Namespace/Health/Service/V2.0">
      <CorrelationID xmlns="http://www.immi.gov.au/Namespace/Health/Core/V1.0">362291741250712573</CorrelationID>
      <CachedCreationDate xmlns="http://www.immi.gov.au/Namespace/Health/Core/V1.0">
        <ns4:UnstructuredYear xmlns:ns4="http://www.immi.gov.au/Namespace/PersonIdentity/Core/V1.0">2024</ns4:UnstructuredYear>
        <ns4:UnstructuredMonth xmlns:ns4="http://www.immi.gov.au/Namespace/PersonIdentity/Core/V1.0">1</ns4:UnstructuredMonth>
        <ns4:UnstructuredDay xmlns:ns4="http://www.immi.gov.au/Namespace/PersonIdentity/Core/V1.0">19</ns4:UnstructuredDay>
      </CachedCreationDate>
      <ns2:HealthCaseIdentifierMsg xmlns:ns2="http://www.immi.gov.au/Namespace/Health/Messaging/Service/V1.0">
        <HealthCaseIdentifier xmlns="http://www.immi.gov.au/Namespace/Health/Core/V1.0">
          <HealthCaseIdentifierValue>1705635497213</HealthCaseIdentifierValue>
          <HealthCaseIdentifierType>IME</HealthCaseIdentifierType>
        </HealthCaseIdentifier>
      </ns2:HealthCaseIdentifierMsg>
      <ns3:RegisterHealthCaseClientBiographicalDetails>
        <ns5:GivenName xmlns:ns5="http://www.immi.gov.au/Namespace/Enterprise/Core/V1.0">Test Patient</ns5:GivenName>
        <ns5:FamilyName xmlns:ns5="http://www.immi.gov.au/Namespace/Enterprise/Core/V1.0">Last Name</ns5:FamilyName>
      </ns3:RegisterHealthCaseClientBiographicalDetails>
    </ns3:RegisterHealthCaseRequest>
  </soap:Body>
</soap:Envelope>

### Test 2: Send full SOAP message from file (PowerShell)
# $soapXml = Get-Content -Path "Medical/src/Test/SampleMessages/00_sv445_1.xml" -Raw
# Invoke-RestMethod -Uri "http://localhost:7071/api/soap" -Method Post -ContentType "application/xml" -Body $soapXml

### Test 3: Send full SOAP message from file (curl)
# curl -X POST http://localhost:7071/api/soap \
#   -H "Content-Type: application/xml" \
#   --data @Medical/src/Test/SampleMessages/00_sv445_1.xml

###############################################################################
### INCORRECT APPROACH - Sending raw SOAP to Service Bus Topic
### This will NOT work because NServiceBus expects wrapped messages
###############################################################################

### ❌ This will fail - Direct to Service Bus topic (no NServiceBus wrapper)
# POST https://apim-migration-dev-eastus2-123.azure-api.net/topics/medical.domain.contracts.events.emedicalmsgrecieved/messages
# Content-Type: application/xml
#
# <soap:Envelope>...</soap:Envelope>

###############################################################################
### CORRECT APPROACH for APIM Integration
###############################################################################

### If APIM must send directly to Service Bus, you need to:
### 1. Configure APIM to wrap the SOAP XML in NServiceBus message format, OR
### 2. Have APIM call your Azure Function HTTP endpoint instead (recommended)

### Example APIM Policy to call HTTP Function:
###
### <inbound>
###   <base />
###   <set-backend-service base-url="https://your-function-app.azurewebsites.net/api" />
###   <rewrite-uri template="/soap" />
###   <set-header name="Content-Type" exists-action="override">
###     <value>application/xml</value>
###   </set-header>
### </inbound>
