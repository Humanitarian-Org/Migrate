<?xml version='1.0' encoding='UTF-8'?><xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:errcore="http://www.immi.gov.au/Namespace/Enterprise/ErrorMessages/V1.0" elementFormDefault="qualified" targetNamespace="http://www.immi.gov.au/Namespace/Enterprise/ErrorMessages/V1.0" version="1.0" xml:lang="en">
   <xs:include schemaLocation="https://api-test.iom.int/eMedicalInterface/services/eMedicalPort12?xsd=xsd/ErrorMessagesCore.xsd"/>
   <xs:complexType name="logicErrorType">
      <xs:sequence>
         <xs:element ref="errcore:OriginatorName"/>
         <xs:element ref="errcore:OriginatorLocation"/>
         <xs:element ref="errcore:ErrorCode"/>
         <xs:element ref="errcore:DescriptionText"/>
         <xs:element minOccurs="0" ref="errcore:LocationText"/>
         <xs:element minOccurs="0" ref="errcore:AdditionalDetailText"/>
      </xs:sequence>
   </xs:complexType>
   <xs:element name="LogicError" type="errcore:logicErrorType"/>
   <xs:element name="LogicErrors" type="errcore:logicErrorsType"/>
   <xs:complexType name="logicErrorsType">
      <xs:sequence>
         <xs:element maxOccurs="unbounded" ref="errcore:LogicError"/>
      </xs:sequence>
   </xs:complexType>
</xs:schema>